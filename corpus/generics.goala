package collections

// Generics (DESIGN 2.2): Go-style type parameters passed through on sealed
// types, functions, and higher-order function-typed parameters.
sealed Tree[T any] {
    Leaf(value T),
    Node(left Tree[T], right Tree[T]),
}

func head[T any](xs []T) Option[T] {
    for x in xs {
        return Some(x)
    }
    None[T]()
}

func size[T any](t Tree[T]) int = match t {
    Leaf(_) => 1,
    Node(l, r) => size(l) + size(r),
}

func mapTree[T any, U any](t Tree[T], f func(T) U) Tree[U] = match t {
    Leaf(v) => Leaf(f(v)),
    Node(l, r) => Node(mapTree(l, f), mapTree(r, f)),
}
